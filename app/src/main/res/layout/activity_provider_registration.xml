<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primary"
    tools:context=".ProviderRegistrationActivity">

    <ImageView
        android:id="@+id/btn_back"
        style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/layout_24dp"
        android:layout_marginTop="@dimen/layout_24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_sign_in_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_24dp"
        android:text="@string/already_have_provider_account"
        android:textColor="@color/white"
        android:textSize="@dimen/layout_13sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/logo_container"
        android:layout_width="@dimen/layout_96dp"
        android:layout_height="@dimen/layout_96dp"
        android:layout_marginTop="@dimen/layout_16dp"
        android:src="@drawable/logo_main_washlink"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        app:tint="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_sign_in_prompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/logo_container"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/layout_680dp"
            android:background="@drawable/bg_auth_card"
            android:paddingStart="@dimen/layout_24dp"
            android:paddingEnd="@dimen/layout_24dp"
            android:paddingTop="@dimen/layout_24dp"
            android:paddingBottom="@dimen/layout_24dp">

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.WashLink.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/provider_registration_title"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/TextAppearance.WashLink.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                android:text="@string/provider_registration_subtitle"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Business Name -->
            <TextView
                android:id="@+id/label_business_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_24dp"
                android:text="@string/business_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_business_name"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/label_business_name">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/provider_business_name_example"
                    android:inputType="text"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Owner Name -->
            <TextView
                android:id="@+id/label_owner_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/owner_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/til_business_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_owner_name"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/label_owner_name">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/provider_owner_name_hint"
                    android:inputType="textPersonName"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Business Email -->
            <TextView
                android:id="@+id/label_business_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/business_email"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/til_owner_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_business_email"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/label_business_email">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/provider_email_example"
                    android:inputType="textEmailAddress"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone -->
            <TextView
                android:id="@+id/label_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/business_phone"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/til_business_email" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/label_phone">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/provider_phone_example"
                    android:inputType="phone"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Business Address -->
            <TextView
                android:id="@+id/label_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/business_address"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/til_phone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_address"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/label_address">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_your_address"
                    android:inputType="textPostalAddress"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_provider_current_location"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_4dp"
                android:text="@string/provider_use_current_location"
                android:textAllCaps="false"
                android:textColor="@color/laundr_blue"
                app:icon="@drawable/ic_location_pin"
                app:layout_constraintTop_toBottomOf="@id/til_address"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_provider_location_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_4dp"
                android:text="@string/provider_location_not_selected"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_12sp"
                app:layout_constraintTop_toBottomOf="@id/btn_provider_current_location"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Password -->
            <TextView
                android:id="@+id/label_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/password"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_provider_location_status" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:endIconMode="password_toggle"
                app:layout_constraintTop_toBottomOf="@id/label_password">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/your_password"
                    android:inputType="textPassword"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/password_strength_meter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_6dp"
                android:layout_marginTop="@dimen/layout_8dp"
                android:max="5"
                android:progress="0"
                app:layout_constraintTop_toBottomOf="@id/til_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/password_strength_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_4dp"
                android:text="@string/password_strength_start"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_12sp"
                app:layout_constraintTop_toBottomOf="@id/password_strength_meter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_business_account"
                style="@style/Widget.WashLink.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_52dp"
                android:layout_marginTop="@dimen/layout_24dp"
                android:text="@string/create_business_account"
                android:textAllCaps="false"
                android:textSize="@dimen/layout_16sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/laundr_blue"
                app:cornerRadius="@dimen/radius_button"
                app:layout_constraintTop_toBottomOf="@id/password_strength_feedback" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
