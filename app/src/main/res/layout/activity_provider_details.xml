<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:id="@+id/iv_provider_avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/bg_thumbnail_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_back_arrow"
        app:tint="@color/laundr_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_provider_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Provider Name"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/iv_provider_avatar"
        app:layout_constraintStart_toEndOf="@id/iv_provider_avatar"
        app:layout_constraintEnd_toStartOf="@id/btn_back" />

    <TextView
        android:id="@+id/tv_provider_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open now"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_provider_name"
        app:layout_constraintStart_toStartOf="@id/tv_provider_name" />

    <TextView
        android:id="@+id/tv_provider_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="4.8"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_provider_status"
        app:layout_constraintStart_toStartOf="@id/tv_provider_name" />

    <TextView
        android:id="@+id/tv_provider_reviews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="214 reviews"
        app:layout_constraintTop_toTopOf="@id/tv_provider_rating"
        app:layout_constraintStart_toEndOf="@id/tv_provider_rating" />

    <TextView
        android:id="@+id/tv_provider_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0.8 km away"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_provider_rating"
        app:layout_constraintStart_toEndOf="@id/tv_provider_reviews" />

    <TextView
        android:id="@+id/tv_provider_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="From UGX 20,000 /kg"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_provider_distance"
        app:layout_constraintStart_toStartOf="@id/tv_provider_name" />

    <Button
        android:id="@+id/btn_call_provider_details"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:text="Call"
        android:backgroundTint="@color/white"
        android:textColor="@color/laundr_blue"
        app:layout_constraintTop_toBottomOf="@id/tv_provider_price"
        app:layout_constraintStart_toStartOf="@id/tv_provider_name" />

    <Button
        android:id="@+id/btn_book_provider"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="Book"
        android:backgroundTint="@color/laundr_blue"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/btn_call_provider_details"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>