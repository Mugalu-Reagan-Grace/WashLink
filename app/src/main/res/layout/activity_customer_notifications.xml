<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notifications_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <ImageView
        android:id="@+id/btn_back"
        style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_notifications_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notifications"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_18sp"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/layout_20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent" />

    <ListView
        android:id="@+id/lv_notifications"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/layout_12dp"
        android:paddingTop="@dimen/layout_8dp"
        android:paddingBottom="@dimen/layout_8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/layout_10dp"
        android:paddingStart="@dimen/layout_16dp"
        android:paddingEnd="@dimen/layout_16dp"
        android:clipToPadding="false"
        tools:listitem="@layout/activity_customer_notification_item"
        tools:itemCount="3"
        app:layout_constraintTop_toBottomOf="@id/tv_notifications_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_notifications_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/layout_120dp"
        android:padding="@dimen/layout_24dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/lv_notifications"
        app:layout_constraintBottom_toBottomOf="@id/lv_notifications"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>