<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primary"
    tools:context=".CreateAccountActivity">

    <!-- Top blue header -->
    <TextView
        android:id="@+id/tv_sign_in_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_24dp"
        android:text="@string/sign_in_prompt"
        android:textColor="@color/white"
        android:textSize="@dimen/layout_13sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/tv_logo"
        android:layout_width="@dimen/layout_96dp"
        android:layout_height="@dimen/layout_96dp"
        android:layout_marginTop="@dimen/layout_24dp"
        android:src="@drawable/logo_main_washlink"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        app:tint="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_sign_in_prompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- White card -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_logo"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/layout_600dp"
            android:background="@drawable/bg_auth_card"
            android:paddingStart="@dimen/layout_24dp"
            android:paddingEnd="@dimen/layout_24dp"
            android:paddingTop="@dimen/layout_24dp"
            android:paddingBottom="@dimen/layout_24dp">

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.WashLink.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/create_account"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/TextAppearance.WashLink.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                android:text="@string/create_account_subtitle"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Email Address -->
            <TextView
                android:id="@+id/label_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_24dp"
                android:text="@string/email_address"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/label_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:id="@+id/et_email_reg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Your Name -->
            <TextView
                android:id="@+id/label_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/your_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/til_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/label_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:id="@+id/et_name_reg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_your_name"
                    android:inputType="textPersonName"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone Number -->
            <TextView
                android:id="@+id/label_phone_reg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/phone_number"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/til_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone_reg"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/label_phone_reg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:id="@+id/et_phone_reg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_phone_number"
                    android:inputType="phone"
                    android:textSize="@dimen/layout_14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verify_phone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/layout_48dp"
                android:layout_marginTop="@dimen/layout_8dp"
                android:text="@string/verify_phone"
                android:textAllCaps="false"
                android:textColor="@color/laundr_blue"
                app:cornerRadius="@dimen/radius_button"
                app:layout_constraintTop_toBottomOf="@id/til_phone_reg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:strokeColor="@color/laundr_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resend_phone"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_4dp"
                android:text="@string/resend_verification_code"
                android:textAllCaps="false"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/btn_verify_phone"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone_code"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:layout_constraintTop_toBottomOf="@id/btn_resend_phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:id="@+id/et_phone_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_verification_code"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="@dimen/layout_14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_phone_consent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_4dp"
                android:text="@string/phone_sms_consent"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_11sp"
                app:layout_constraintTop_toBottomOf="@id/til_phone_code"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Password -->
            <TextView
                android:id="@+id/label_password"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/password"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_phone_consent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:endIconMode="password_toggle"
                app:layout_constraintTop_toBottomOf="@id/label_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:id="@+id/et_password_reg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/your_password"
                    android:inputType="textPassword"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/password_strength_meter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/layout_6dp"
                android:layout_marginTop="@dimen/layout_8dp"
                android:max="5"
                android:progress="0"
                app:layout_constraintTop_toBottomOf="@id/til_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/password_strength_feedback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_4dp"
                android:text="@string/password_strength_start"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_12sp"
                app:layout_constraintTop_toBottomOf="@id/password_strength_meter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/label_confirm_password"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/confirm_password"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/password_strength_feedback"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_confirm_password"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:endIconMode="password_toggle"
                app:layout_constraintTop_toBottomOf="@id/label_confirm_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:id="@+id/et_confirm_password_reg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/re_enter_password"
                    android:inputType="textPassword"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Remember me -->
            <CheckBox
                android:id="@+id/checkbox_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:buttonTint="@color/laundr_blue"
                android:text="@string/accept_terms_and_conditions"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_confirm_password" />

            <!-- Sign Up button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_up"
                style="@style/Widget.WashLink.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/layout_52dp"
                android:layout_marginTop="@dimen/layout_24dp"
                android:text="@string/sign_up"
                android:textAllCaps="false"
                android:textSize="@dimen/layout_16sp"
                android:textColor="@color/white"
                android:enabled="false"
                android:backgroundTint="@color/laundr_blue"
                app:cornerRadius="@dimen/radius_button"
                app:layout_constraintTop_toBottomOf="@id/checkbox_terms"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_max="@dimen/layout_320dp" />

            <!-- Divider -->
            <View
                android:id="@+id/divider_start"
                android:layout_width="0dp"
                android:layout_height="@dimen/layout_1dp"
                android:layout_marginTop="@dimen/layout_24dp"
                android:background="@color/divider_gray"
                app:layout_constraintTop_toBottomOf="@id/btn_sign_up"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_or_continue" />

            <TextView
                android:id="@+id/tv_or_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_8dp"
                android:layout_marginEnd="@dimen/layout_8dp"
                android:text="@string/or_continue_with"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/layout_12sp"
                app:layout_constraintBottom_toBottomOf="@id/divider_start"
                app:layout_constraintEnd_toStartOf="@id/divider_end"
                app:layout_constraintStart_toEndOf="@id/divider_start"
                app:layout_constraintTop_toTopOf="@id/divider_start" />

            <View
                android:id="@+id/divider_end"
                android:layout_width="0dp"
                android:layout_height="@dimen/layout_1dp"
                android:background="@color/divider_gray"
                app:layout_constraintTop_toTopOf="@id/divider_start"
                app:layout_constraintBottom_toBottomOf="@id/divider_start"
                app:layout_constraintStart_toEndOf="@id/tv_or_continue"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Google button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google_outlined"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/layout_52dp"
                android:layout_marginTop="@dimen/layout_16dp"
                android:layout_marginBottom="@dimen/layout_8dp"
                android:text="@string/continue_with_google"
                android:textAllCaps="false"
                android:textSize="@dimen/layout_15sp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/layout_10dp"
                app:iconSize="@dimen/layout_20dp"
                app:iconTint="@null"
                app:strokeColor="@color/google_button_border"
                app:cornerRadius="@dimen/radius_button"
                app:layout_constraintTop_toBottomOf="@id/tv_or_continue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_max="@dimen/layout_320dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
