<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ProviderProfileActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:text="@string/provider_profile_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_provider_menu"
        app:layout_constraintEnd_toStartOf="@id/tv_edit" />

    <ImageView
        android:id="@+id/btn_provider_menu"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/layout_12dp"
        android:padding="@dimen/layout_6dp"
        android:src="@drawable/ic_menu_lines"
        android:contentDescription="@string/provider_nav_more"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_edit"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="@dimen/touch_target_min"
        android:paddingStart="@dimen/layout_8dp"
        android:paddingEnd="@dimen/layout_8dp"
        android:text="@string/edit_profile"
        android:textColor="@color/laundr_blue"
        android:textSize="@dimen/layout_13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_profile_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_4dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:text="@string/provider_workspace_profile_description"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_13sp"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_subtitle"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/layout_20dp"
            android:paddingEnd="@dimen/layout_20dp"
            android:paddingTop="@dimen/layout_20dp">

            <!-- Business info card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_business_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_16dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="@dimen/layout_56dp"
                    android:layout_height="@dimen/layout_56dp"
                    android:background="@drawable/bg_thumbnail_placeholder"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/edit_profile_picture"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_business_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:text="@string/provider_business_name_fallback"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/iv_logo"
                    app:layout_constraintStart_toEndOf="@id/iv_logo"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:layout_marginTop="@dimen/layout_4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/tv_business_name"
                    app:layout_constraintStart_toEndOf="@id/iv_logo">

                    <ImageView
                        android:layout_width="@dimen/layout_13dp"
                        android:layout_height="@dimen/layout_13dp"
                        android:src="@drawable/ic_star_filled"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_profile_rating_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/layout_4dp"
                        android:text="@string/provider_workspace_new_rating"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/layout_12sp" />

                    <TextView
                        android:id="@+id/tv_profile_review_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/layout_4dp"
                        android:text="@string/provider_no_reviews"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/layout_12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_12dp"
                    android:text="@string/provider_workspace_address_unset"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/iv_logo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_provider_phone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_4dp"
                    android:text="@string/provider_workspace_phone_unset"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_address"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_provider_availability"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_4dp"
                    android:text="@string/provider_workspace_availability_unset"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_provider_phone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_profile_completion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:background="@drawable/bg_offer_card"
                android:padding="@dimen/layout_12dp"
                android:text="@string/provider_workspace_profile_loading"
                android:textColor="@color/laundr_blue_dark"
                android:textSize="@dimen/layout_12sp"
                app:layout_constraintTop_toBottomOf="@id/card_business_info" />

            <!-- Description -->
            <TextView
                android:id="@+id/label_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_20dp"
                android:text="@string/business_description"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_profile_completion" />

            <TextView
                android:id="@+id/tv_description_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_6dp"
                android:text="@string/provider_workspace_description_empty"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_13sp"
                android:lineSpacingExtra="@dimen/layout_2dp"
                app:layout_constraintTop_toBottomOf="@id/label_description" />

            <!-- Operating Hours -->
            <TextView
                android:id="@+id/label_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_20dp"
                android:text="@string/operating_hours"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_description_value" />

            <TextView
                android:id="@+id/tv_hours_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_6dp"
                android:text="@string/provider_workspace_hours_empty"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_13sp"
                android:lineSpacingExtra="@dimen/layout_2dp"
                app:layout_constraintTop_toBottomOf="@id/label_hours" />

            <!-- Settings rows -->
            <LinearLayout
                android:id="@+id/row_manage_services"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/layout_24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/layout_10dp"
                android:paddingBottom="@dimen/layout_10dp"
                app:layout_constraintTop_toBottomOf="@id/tv_hours_value">

                <ImageView
                    android:layout_width="@dimen/layout_22dp"
                    android:layout_height="@dimen/layout_22dp"
                    android:src="@drawable/ic_nav_services"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:text="@string/manage_services_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_manage_riders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/layout_10dp"
                android:paddingBottom="@dimen/layout_10dp"
                app:layout_constraintTop_toBottomOf="@id/row_manage_services">

                <ImageView
                    android:layout_width="@dimen/layout_22dp"
                    android:layout_height="@dimen/layout_22dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:text="@string/provider_workspace_manage_riders"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_provider_reports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/layout_10dp"
                android:paddingBottom="@dimen/layout_10dp"
                app:layout_constraintTop_toBottomOf="@id/row_manage_riders">

                <ImageView
                    android:layout_width="@dimen/layout_22dp"
                    android:layout_height="@dimen/layout_22dp"
                    android:src="@drawable/ic_provider_stat_revenue"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:text="@string/provider_workspace_business_reports"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:id="@+id/divider_theme_top"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_1dp"
                android:background="@color/divider_gray"
                app:layout_constraintTop_toBottomOf="@id/row_provider_reports" />

            <LinearLayout
                android:id="@+id/row_provider_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/layout_10dp"
                android:paddingBottom="@dimen/layout_10dp"
                app:layout_constraintTop_toBottomOf="@id/divider_theme_top">

                <ImageView
                    android:layout_width="@dimen/layout_22dp"
                    android:layout_height="@dimen/layout_22dp"
                    android:src="@drawable/ic_profile_card"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:text="@string/provider_workspace_appearance"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_provider_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:minWidth="@dimen/touch_target_min"
                    android:contentDescription="@string/provider_workspace_toggle_dark_mode"
                    android:showText="false" />
            </LinearLayout>

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_1dp"
                android:background="@color/divider_gray"
                app:layout_constraintTop_toBottomOf="@id/row_provider_theme" />

            <LinearLayout
                android:id="@+id/row_payment_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/layout_10dp"
                android:paddingBottom="@dimen/layout_10dp"
                app:layout_constraintTop_toBottomOf="@id/divider1">

                <ImageView
                    android:layout_width="@dimen/layout_22dp"
                    android:layout_height="@dimen/layout_22dp"
                    android:src="@drawable/ic_profile_card"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:text="@string/provider_payout_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_1dp"
                android:background="@color/divider_gray"
                app:layout_constraintTop_toBottomOf="@id/row_payment_settings" />

            <LinearLayout
                android:id="@+id/row_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/layout_10dp"
                android:paddingBottom="@dimen/layout_10dp"
                app:layout_constraintTop_toBottomOf="@id/divider2">

                <ImageView
                    android:layout_width="@dimen/layout_22dp"
                    android:layout_height="@dimen/layout_22dp"
                    android:src="@drawable/ic_profile_password"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:text="@string/profile_password"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_48dp"
                android:layout_marginTop="@dimen/layout_28dp"
                android:text="@string/provider_logout"
                android:textAllCaps="false"
                android:textSize="@dimen/layout_14sp"
                android:textColor="@color/logout_red"
                app:icon="@drawable/ic_logout"
                app:iconTint="@null"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/layout_8dp"
                app:strokeColor="@color/logout_red"
                app:cornerRadius="@dimen/layout_12dp"
                app:layout_constraintTop_toBottomOf="@id/row_password" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom nav (Profile tab active) -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/activity_provider_nav_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/layout_56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
