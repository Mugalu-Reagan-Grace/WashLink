<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/layout_12dp"
    android:background="@drawable/bg_card_bordered"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="@dimen/layout_16dp">

    <TextView
        android:id="@+id/tv_booking_customer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_booking_status" />

    <TextView
        android:id="@+id/tv_booking_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="@dimen/layout_10dp"
        android:paddingTop="@dimen/layout_4dp"
        android:paddingEnd="@dimen/layout_10dp"
        android:paddingBottom="@dimen/layout_4dp"
        android:textColor="@color/status_processing_text"
        android:textSize="@dimen/layout_11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_booking_service"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_4dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_booking_customer"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_booking_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_6dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_booking_service"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_booking_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_3dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_booking_date"
        app:layout_constraintEnd_toStartOf="@id/tv_booking_price" />

    <TextView
        android:id="@+id/tv_booking_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/laundr_blue"
        android:textSize="@dimen/layout_14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_booking_type" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_10dp"
        android:text="@string/provider_booking_view_details"
        android:textColor="@color/laundr_blue"
        android:textSize="@dimen/layout_12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_booking_type" />

</androidx.constraintlayout.widget.ConstraintLayout>
