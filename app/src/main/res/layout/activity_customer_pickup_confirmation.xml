<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".PickupConfirmationActivity">

    <!-- Header -->
    <ImageView
        android:id="@+id/btn_back"
        style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_12dp"
        android:layout_marginEnd="@dimen/layout_12dp"
        android:text="@string/pickup_confirmation_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_17sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/iv_bell" />

    <FrameLayout
        android:id="@+id/iv_bell"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bell"
            app:tint="@color/laundr_blue"
            android:contentDescription="@null" />

        <View
            android:layout_width="@dimen/layout_7dp"
            android:layout_height="@dimen/layout_7dp"
            android:layout_gravity="top|end"
            android:background="@drawable/dot_notification" />
    </FrameLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/layout_20dp"
            android:paddingEnd="@dimen/layout_20dp"
            android:paddingTop="@dimen/layout_20dp">

            <!-- Pickup Logistics card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_logistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_logistics_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pickup_logistics"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_edit_logistics" />

                <TextView
                    android:id="@+id/tv_edit_logistics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit"
                    android:textColor="@color/laundr_blue"
                    android:textSize="@dimen/layout_13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/tv_logistics_label"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_datetime_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_10dp"
                    android:text="@string/pickup_datetime_value"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_13sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_logistics_label"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_address_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_6dp"
                    android:text="@string/home_address_value"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_13sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_datetime_value"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Number of Items -->
            <TextView
                android:id="@+id/label_items"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_20dp"
                android:text="@string/number_of_items"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/card_logistics"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/stepper_items"
                app:layout_constraintBottom_toBottomOf="@id/stepper_items" />

            <LinearLayout
                android:id="@+id/stepper_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_bordered"
                app:layout_constraintTop_toBottomOf="@id/card_logistics"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/btn_minus"
                    android:layout_width="@dimen/layout_48dp"
                    android:layout_height="@dimen/layout_48dp"
                    android:padding="@dimen/layout_12dp"
                    android:src="@drawable/ic_minus"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/decrease_items" />

                <TextView
                    android:id="@+id/tv_item_count"
                    android:layout_width="@dimen/layout_32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/default_item_count"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_plus"
                    android:layout_width="@dimen/layout_48dp"
                    android:layout_height="@dimen/layout_48dp"
                    android:padding="@dimen/layout_12dp"
                    android:src="@drawable/ic_plus"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/increase_items" />

            </LinearLayout>

            <!-- Estimated Weight -->
            <TextView
                android:id="@+id/label_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_20dp"
                android:text="@string/estimated_weight"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/stepper_items"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dropdown_weight"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_52dp"
                android:layout_marginTop="@dimen/layout_8dp"
                android:background="@drawable/bg_top_rounded_white"
                android:backgroundTint="@color/input_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/estimated_weight"
                app:layout_constraintTop_toBottomOf="@id/label_weight"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_weight_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_14dp"
                    android:text="@string/booking_weight_default"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:layout_width="@dimen/layout_18dp"
                    android:layout_height="@dimen/layout_18dp"
                    android:layout_marginEnd="@dimen/layout_14dp"
                    android:src="@drawable/ic_chevron_right"
                    android:rotation="90"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Special Instructions -->
            <TextView
                android:id="@+id/label_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_20dp"
                android:text="@string/special_instructions"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/dropdown_weight"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_instructions"
                style="@style/Widget.WashLink.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                app:boxBackgroundColor="@color/input_bg"
                app:boxCornerRadiusTopStart="@dimen/layout_10dp"
                app:boxCornerRadiusTopEnd="@dimen/layout_10dp"
                app:boxCornerRadiusBottomStart="@dimen/layout_10dp"
                app:boxCornerRadiusBottomEnd="@dimen/layout_10dp"
                app:boxStrokeWidth="@dimen/layout_1dp"
                app:boxStrokeWidthFocused="@dimen/layout_2dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/label_instructions"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/WashLinkInputText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/layout_80dp"
                    android:gravity="top"
                    android:hint="@string/special_instructions_hint"
                    android:inputType="textMultiLine"
                    android:textSize="@dimen/layout_14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_fee_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:background="@drawable/bg_offer_card"
                android:padding="@dimen/layout_10dp"
                android:text="@string/pickup_delivery_fee_note"
                android:textColor="@color/laundr_blue"
                android:textSize="@dimen/layout_12sp"
                app:layout_constraintTop_toBottomOf="@id/til_instructions"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Contact Preference (compact) -->
            <TextView
                android:id="@+id/label_contact_pref"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/contact_preference"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_13sp"
                app:layout_constraintTop_toBottomOf="@id/tv_fee_note"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/row_contact_pref_compact"
                app:layout_constraintBottom_toBottomOf="@id/row_contact_pref_compact" />

            <LinearLayout
                android:id="@+id/row_contact_pref_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tv_fee_note"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/chip_call_compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/layout_48dp"
                    android:layout_marginEnd="@dimen/layout_8dp"
                    android:paddingStart="@dimen/layout_16dp"
                    android:paddingEnd="@dimen/layout_16dp"
                    android:paddingTop="@dimen/layout_8dp"
                    android:paddingBottom="@dimen/layout_8dp"
                    android:background="@drawable/bg_chip_selected"
                    android:text="@string/contact_call"
                    android:textColor="@color/white"
                    android:textSize="@dimen/layout_12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_text_compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/layout_48dp"
                    android:paddingStart="@dimen/layout_16dp"
                    android:paddingEnd="@dimen/layout_16dp"
                    android:paddingTop="@dimen/layout_8dp"
                    android:paddingBottom="@dimen/layout_8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="@string/contact_text"
                    android:textColor="@color/chip_unselected_text"
                    android:textSize="@dimen/layout_12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Pick Up Fee -->
            <LinearLayout
                android:id="@+id/row_pickup_fee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/row_contact_pref_compact">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pick_up_fee"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pickup_delivery_fee_amount"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky bottom bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="@dimen/layout_8dp"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:paddingTop="@dimen/layout_12dp"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_pickup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_52dp"
            android:text="@string/confirm_pickup"
            android:textAllCaps="false"
            android:textSize="@dimen/layout_15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/laundr_blue"
            app:cornerRadius="@dimen/radius_button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
