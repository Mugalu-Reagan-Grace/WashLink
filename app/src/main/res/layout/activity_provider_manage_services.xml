<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ManageServicesActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginEnd="@dimen/layout_12dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:text="@string/manage_services_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_provider_menu"
        app:layout_constraintEnd_toStartOf="@id/btn_add_service" />

    <ImageView
        android:id="@+id/btn_provider_menu"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/layout_12dp"
        android:padding="@dimen/layout_6dp"
        android:src="@drawable/ic_menu_lines"
        android:contentDescription="@string/provider_nav_more"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btn_add_service"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:padding="@dimen/layout_8dp"
        android:src="@drawable/ic_plus"
        android:background="@drawable/bg_offer_card"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/add_service"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_services_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_6dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:text="@string/provider_workspace_service_description"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_13sp"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_booking_options_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_12dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:text="@string/provider_booking_options"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_services_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_booking_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_16dp"
        android:layout_marginEnd="@dimen/layout_16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_booking_options_title">

        <LinearLayout
            android:id="@+id/row_supports_pickup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_supports_pickup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/provider_supports_pickup" />
            <TextView
                android:id="@+id/tv_supports_pickup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_4dp"
                android:text="@string/provider_supports_pickup"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_supports_dropoff"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_supports_dropoff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/provider_supports_dropoff" />
            <TextView
                android:id="@+id/tv_supports_dropoff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_4dp"
                android:text="@string/provider_supports_dropoff"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_booking_options"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_48dp"
            android:layout_marginStart="@dimen/layout_4dp"
            android:layout_marginEnd="@dimen/layout_4dp"
            android:text="@string/save_booking_options"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/layout_10dp" />
    </LinearLayout>

    <!-- Services list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_services"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:paddingTop="@dimen/layout_20dp"
        android:paddingBottom="@dimen/layout_16dp"
        tools:listitem="@layout/activity_provider_service_item"
        tools:itemCount="4"
        app:layout_constraintTop_toBottomOf="@id/layout_booking_options"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar" />

    <TextView
        android:id="@+id/tv_services_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/layout_24dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rv_services"
        app:layout_constraintBottom_toBottomOf="@id/rv_services"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom nav (Services tab active) -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/activity_provider_nav_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/layout_56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
