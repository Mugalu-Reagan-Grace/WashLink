<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@color/white"
    android:elevation="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/iv_nav_dashboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="13dp"
        android:src="@drawable/ic_nav_home"
        android:contentDescription="@string/nav_home"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/nav_inactive" />

    <ImageView
        android:id="@+id/iv_nav_bookings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="13dp"
        android:src="@drawable/ic_nav_history"
        android:contentDescription="@string/nav_history"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/nav_inactive" />

    <ImageView
        android:id="@+id/iv_nav_services"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="13dp"
        android:src="@drawable/ic_nav_services"
        android:contentDescription="@string/nav_services"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/nav_inactive" />

    <ImageView
        android:id="@+id/iv_nav_chat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="13dp"
        android:src="@drawable/ic_chat_bubble"
        android:contentDescription="@string/provider_chat"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/nav_inactive" />

    <ImageView
        android:id="@+id/iv_nav_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="13dp"
        android:src="@drawable/ic_nav_profile"
        android:contentDescription="@string/nav_profile"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/nav_inactive" />
</LinearLayout>
