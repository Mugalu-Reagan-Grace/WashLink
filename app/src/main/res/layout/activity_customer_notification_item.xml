<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_target_min"
    android:background="@drawable/bg_card_bordered"
    android:orientation="vertical"
    android:padding="@dimen/layout_16dp"
    tools:showIn="@layout/activity_customer_notifications">

    <TextView
        android:id="@+id/tv_notification_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_14sp"
        android:lineSpacingExtra="@dimen/layout_3dp"
        tools:text="@string/preview_notification" />

</LinearLayout>
