<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingTop="12dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_provider_menu"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:padding="6dp"
            android:src="@drawable/ic_menu_lines"
            android:contentDescription="@string/provider_nav_more"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btn_chat_inbox_back"
            style="@style/WashLinkBackButton"
            android:layout_marginStart="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/chat_inbox_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_chat_inbox_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:padding="24dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/chat_inbox_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <include
        android:id="@+id/provider_chat_nav"
        layout="@layout/activity_provider_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp" />
</LinearLayout>
