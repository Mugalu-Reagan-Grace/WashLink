<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:paddingTop="@dimen/layout_12dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/layout_16dp"
        android:paddingEnd="@dimen/layout_16dp">

        <ImageView
            android:id="@+id/btn_provider_menu"
            android:layout_width="@dimen/layout_36dp"
            android:layout_height="@dimen/layout_48dp"
            android:padding="@dimen/layout_6dp"
            android:src="@drawable/ic_menu_lines"
            android:contentDescription="@string/provider_nav_more"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btn_chat_inbox_back"
            style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
            android:layout_marginStart="@dimen/layout_4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/layout_12dp"
            android:layout_weight="1"
            android:text="@string/chat_inbox_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/layout_20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_chat_inbox_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/layout_120dp"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:padding="@dimen/layout_24dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/chat_inbox_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <include
        android:id="@+id/provider_chat_nav"
        layout="@layout/activity_provider_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_56dp" />
</LinearLayout>
