<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/layout_16dp"
        android:paddingEnd="@dimen/layout_16dp">

        <ImageView
            android:id="@+id/btn_provider_menu"
            android:layout_width="@dimen/layout_36dp"
            android:layout_height="@dimen/layout_48dp"
            android:padding="@dimen/layout_6dp"
            android:src="@drawable/ic_menu_lines"
            android:contentDescription="@string/provider_nav_more"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btn_chat_back"
            style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
            android:layout_marginStart="@dimen/layout_4dp" />

        <TextView
            android:id="@+id/tv_chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/layout_12dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/layout_18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_chat_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/touch_target_min"
        android:padding="@dimen/layout_8dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/layout_16dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/chat_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:elevation="@dimen/layout_8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/layout_12dp">

        <EditText
            android:id="@+id/et_chat_message"
            android:layout_width="0dp"
            android:layout_height="@dimen/layout_48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_bordered"
            android:hint="@string/chat_message_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="4"
            android:paddingStart="@dimen/layout_12dp"
            android:paddingEnd="@dimen/layout_12dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/layout_14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chat_send"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/layout_48dp"
            android:layout_marginStart="@dimen/layout_8dp"
            android:minWidth="@dimen/layout_72dp"
            android:text="@string/chat_send"
            android:textAllCaps="false" />
    </LinearLayout>

    <include
        android:id="@+id/provider_chat_thread_nav"
        layout="@layout/activity_provider_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_56dp" />
</LinearLayout>
