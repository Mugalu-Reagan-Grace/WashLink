<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".BookingRequestsActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_12dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:layout_marginEnd="@dimen/layout_12dp"
        android:text="@string/booking_requests_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_provider_menu"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btn_provider_menu"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/layout_12dp"
        android:padding="@dimen/layout_6dp"
        android:src="@drawable/ic_menu_lines"
        android:contentDescription="@string/provider_nav_more"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_booking_requests_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_4dp"
        android:text="@string/provider_bookings_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tabs -->
    <LinearLayout
        android:id="@+id/tab_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_booking_requests_subtitle">

        <TextView
            android:id="@+id/tab_pending"
            android:layout_width="0dp"
            android:layout_height="@dimen/layout_48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="@dimen/layout_10dp"
            android:paddingBottom="@dimen/layout_10dp"
            android:background="@drawable/bg_chip_selected"
            android:text="@string/tab_pending"
            android:textColor="@color/white"
            android:textSize="@dimen/layout_13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_accepted"
            android:layout_width="0dp"
            android:layout_height="@dimen/layout_48dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/layout_8dp"
            android:gravity="center"
            android:paddingTop="@dimen/layout_10dp"
            android:paddingBottom="@dimen/layout_10dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="@string/tab_accepted"
            android:textColor="@color/chip_unselected_text"
            android:textSize="@dimen/layout_13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_history"
            android:layout_width="0dp"
            android:layout_height="@dimen/layout_48dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/layout_8dp"
            android:gravity="center"
            android:paddingTop="@dimen/layout_10dp"
            android:paddingBottom="@dimen/layout_10dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="@string/tab_history"
            android:textColor="@color/chip_unselected_text"
            android:textSize="@dimen/layout_13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Booking requests list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_booking_requests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:paddingTop="@dimen/layout_16dp"
        android:paddingBottom="@dimen/layout_16dp"
        tools:listitem="@layout/activity_customer_order_history_item"
        tools:itemCount="3"
        app:layout_constraintTop_toBottomOf="@id/tab_row"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar" />

    <TextView
        android:id="@+id/tv_booking_requests_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/layout_24dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rv_booking_requests"
        app:layout_constraintBottom_toBottomOf="@id/rv_booking_requests"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom nav (Bookings tab active) -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/activity_provider_nav_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/layout_56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
