<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_16dp"
        android:layout_marginTop="@dimen/layout_12dp"
        android:layout_marginEnd="@dimen/layout_16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_provider_menu"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:clickable="true"
            android:contentDescription="@string/provider_nav_more"
            android:focusable="true"
            android:padding="@dimen/layout_6dp"
            android:src="@drawable/ic_menu_lines" />

        <ImageView
            android:id="@+id/btn_provider_customer_back"
            style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
            android:layout_marginStart="@dimen/layout_4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/provider_workspace_customers_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_provider_customer_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_2dp"
                android:text="@string/provider_workspace_loading_customers"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_8dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:text="@string/provider_workspace_customers_description"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_13sp" />

    <EditText
        android:id="@+id/et_provider_customer_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_14dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:background="@drawable/bg_card_bordered"
        android:hint="@string/provider_workspace_search_name_phone"
        android:inputType="text"
        android:paddingStart="@dimen/layout_14dp"
        android:paddingEnd="@dimen/layout_14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="@dimen/layout_14sp" />

    <TextView
        android:id="@+id/tv_provider_customer_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:gravity="center"
        android:padding="@dimen/layout_24dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp">

        <LinearLayout
            android:id="@+id/provider_customer_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_12dp"
            android:orientation="vertical" />
    </ScrollView>

    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_56dp"
        layout="@layout/activity_provider_nav_bar" />
</LinearLayout>
