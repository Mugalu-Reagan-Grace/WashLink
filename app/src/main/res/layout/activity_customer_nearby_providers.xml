<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".NearbyProvidersActivity">

    <!-- Header -->
    <ImageView
        android:id="@+id/btn_back"
        style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_12dp"
        android:layout_marginEnd="@dimen/layout_12dp"
        android:text="@string/nearby_providers_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_17sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/btn_open_map" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_map"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/layout_48dp"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/nearby_open_map"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:minWidth="@dimen/layout_80dp"
        android:paddingStart="@dimen/layout_12dp"
        android:paddingEnd="@dimen/layout_12dp"
        app:cornerRadius="@dimen/radius_button"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/iv_bell" />

    <FrameLayout
        android:id="@+id/iv_bell"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        android:contentDescription="@string/notifications"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bell"
            android:contentDescription="@null"
            app:tint="@color/laundr_blue" />

        <View
            android:layout_width="@dimen/layout_7dp"
            android:layout_height="@dimen/layout_7dp"
            android:layout_gravity="top|end"
            android:background="@drawable/dot_notification" />
    </FrameLayout>

    <!-- Search bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_52dp"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_16dp"
        android:background="@drawable/bg_card_bordered"
        app:layout_constraintTop_toBottomOf="@id/btn_back">

        <ImageView
            android:id="@+id/ic_search"
            android:layout_width="@dimen/layout_18dp"
            android:layout_height="@dimen/layout_18dp"
            android:layout_marginStart="@dimen/layout_14dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/layout_10dp"
            android:layout_marginEnd="@dimen/layout_14dp"
            android:autofillHints=""
            android:background="@null"
            android:hint="@string/search_providers_hint"
            android:inputType="text"
            android:minHeight="@dimen/layout_48dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/layout_14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ic_search"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:id="@+id/filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/layout_14dp"
        android:scrollbars="none"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/search_bar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:layout_marginEnd="@dimen/layout_8dp"
                android:background="@drawable/bg_chip_selected"
                android:paddingStart="@dimen/layout_16dp"
                android:paddingEnd="@dimen/layout_16dp"
                android:paddingTop="@dimen/layout_8dp"
                android:paddingBottom="@dimen/layout_8dp"
                android:text="@string/filter_all"
                android:textColor="@color/white"
                android:textSize="@dimen/layout_12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_nearest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:layout_marginEnd="@dimen/layout_8dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="@dimen/layout_16dp"
                android:paddingEnd="@dimen/layout_16dp"
                android:paddingTop="@dimen/layout_8dp"
                android:paddingBottom="@dimen/layout_8dp"
                android:text="@string/filter_nearest"
                android:textColor="@color/chip_unselected_text"
                android:textSize="@dimen/layout_12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_top_rated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:layout_marginEnd="@dimen/layout_8dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="@dimen/layout_16dp"
                android:paddingEnd="@dimen/layout_16dp"
                android:paddingTop="@dimen/layout_8dp"
                android:paddingBottom="@dimen/layout_8dp"
                android:text="@string/filter_top_rated"
                android:textColor="@color/chip_unselected_text"
                android:textSize="@dimen/layout_12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_lowest_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:layout_marginEnd="@dimen/layout_20dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="@dimen/layout_16dp"
                android:paddingEnd="@dimen/layout_16dp"
                android:paddingTop="@dimen/layout_8dp"
                android:paddingBottom="@dimen/layout_8dp"
                android:text="@string/filter_lowest_price"
                android:textColor="@color/chip_unselected_text"
                android:textSize="@dimen/layout_12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Result count -->
    <TextView
        android:id="@+id/tv_result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_14dp"
        android:text="@string/providers_found_count"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_12sp"
        app:layout_constraintTop_toBottomOf="@id/filter_scroll" />

    <!-- Provider list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_providers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:paddingTop="@dimen/layout_12dp"
        android:paddingBottom="@dimen/layout_16dp"
        tools:listitem="@layout/activity_provider_item"
        tools:itemCount="5"
        app:layout_constraintTop_toBottomOf="@id/tv_result_count"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tv_providers_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/layout_120dp"
        android:padding="@dimen/layout_24dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rv_providers"
        app:layout_constraintBottom_toBottomOf="@id/rv_providers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
