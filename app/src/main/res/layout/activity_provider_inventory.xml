<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/layout_16dp"
        android:paddingTop="@dimen/layout_10dp"
        android:paddingEnd="@dimen/layout_16dp">

        <ImageView
            android:id="@+id/btn_provider_menu"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:contentDescription="@string/provider_nav_more"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/layout_6dp"
            android:src="@drawable/ic_menu_lines" />

        <ImageView
            android:id="@+id/btn_provider_inventory_back"
            style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
            android:layout_marginStart="@dimen/layout_4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/layout_8dp"
            android:text="@string/provider_workspace_inventory_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/layout_20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/layout_20dp"
            android:paddingTop="@dimen/layout_8dp"
            android:paddingEnd="@dimen/layout_20dp"
            android:paddingBottom="@dimen/layout_20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/provider_workspace_inventory_description"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_13sp" />

            <TextView
                android:id="@+id/tv_provider_inventory_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/layout_18dp"
                android:textColor="@color/pending_text"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_provider_inventory_add"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_52dp"
                android:layout_marginTop="@dimen/layout_8dp"
                android:text="@string/provider_workspace_add_inventory" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_18dp"
                android:text="@string/provider_workspace_current_stock"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/provider_inventory_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_56dp"
        layout="@layout/activity_provider_nav_bar" />
</LinearLayout>
