<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/layout_72dp"
    android:layout_marginBottom="@dimen/layout_10dp"
    android:background="@drawable/bg_card_bordered"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/layout_14dp">

    <TextView
        android:id="@+id/tv_chat_initial"
        android:layout_width="@dimen/layout_44dp"
        android:layout_height="@dimen/layout_44dp"
        android:background="@drawable/bg_offer_card"
        android:gravity="center"
        android:textColor="@color/laundr_blue"
        android:textSize="@dimen/layout_18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_chat_partner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/layout_15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_chat_last_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/layout_13sp" />

        <TextView
            android:id="@+id/tv_chat_timestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_3dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/layout_10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_chat_unread"
        android:layout_width="@dimen/layout_28dp"
        android:layout_height="@dimen/layout_28dp"
        android:layout_marginStart="@dimen/layout_8dp"
        android:background="@drawable/bg_offer_card"
        android:gravity="center"
        android:textColor="@color/laundr_blue"
        android:textSize="@dimen/layout_11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
