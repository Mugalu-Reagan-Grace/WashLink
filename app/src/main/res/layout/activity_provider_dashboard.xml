<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ProviderDashboardActivity">

    <LinearLayout
        android:id="@+id/provider_dashboard_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_16dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_provider_menu"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:padding="@dimen/layout_6dp"
            android:src="@drawable/ic_menu_lines"
            android:contentDescription="@string/provider_nav_more"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/layout_40dp"
            android:layout_height="@dimen/layout_40dp"
            android:background="@drawable/bg_thumbnail_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/layout_12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/provider_greeting"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_12sp" />

            <TextView
                android:id="@+id/tv_business_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/provider_business_name_fallback"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_provider_approval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/provider_approval_checking"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/iv_chat_inbox"
            android:layout_width="@dimen/layout_48dp"
            android:layout_height="@dimen/layout_48dp"
            android:layout_marginStart="@dimen/layout_6dp"
            android:background="@drawable/bg_offer_card"
            android:clickable="true"
            android:contentDescription="@string/provider_chat"
            android:focusable="true"
            android:padding="@dimen/layout_6dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/ic_chat_bubble"
                app:tint="@color/laundr_blue" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/iv_bell"
            android:layout_width="@dimen/layout_32dp"
            android:layout_height="@dimen/layout_32dp"
            android:layout_marginStart="@dimen/layout_8dp">

            <ImageView
                android:layout_width="@dimen/layout_24dp"
                android:layout_height="@dimen/layout_24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                android:contentDescription="@null" />

            <View
                android:layout_width="@dimen/layout_7dp"
                android:layout_height="@dimen/layout_7dp"
                android:layout_gravity="top|end"
                android:background="@drawable/dot_notification" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintTop_toBottomOf="@id/provider_dashboard_header"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/layout_20dp"
            android:paddingEnd="@dimen/layout_20dp"
            android:paddingTop="@dimen/layout_20dp">

            <LinearLayout
                android:id="@+id/provider_dashboard_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/provider_workspace_performance"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dashboard_filter_7_days"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:gravity="center"
                    android:minWidth="@dimen/layout_48dp"
                    android:paddingStart="@dimen/layout_10dp"
                    android:paddingEnd="@dimen/layout_10dp"
                    android:text="@string/provider_workspace_range_7_days"
                    android:textSize="@dimen/layout_12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/provider_workspace_range_7_days" />

                <TextView
                    android:id="@+id/dashboard_filter_30_days"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginStart="@dimen/layout_6dp"
                    android:gravity="center"
                    android:minWidth="@dimen/layout_52dp"
                    android:paddingStart="@dimen/layout_10dp"
                    android:paddingEnd="@dimen/layout_10dp"
                    android:text="@string/provider_workspace_range_30_days"
                    android:textSize="@dimen/layout_12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/provider_workspace_range_30_days" />

                <TextView
                    android:id="@+id/dashboard_filter_90_days"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginStart="@dimen/layout_6dp"
                    android:gravity="center"
                    android:minWidth="@dimen/layout_52dp"
                    android:paddingStart="@dimen/layout_10dp"
                    android:paddingEnd="@dimen/layout_10dp"
                    android:text="@string/provider_workspace_range_90_days"
                    android:textSize="@dimen/layout_12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/provider_workspace_range_90_days" />
            </LinearLayout>

            <!-- Stat cards: 2x2 grid -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stat_bookings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                app:layout_constraintTop_toBottomOf="@id/provider_dashboard_range"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/stat_pending"
                app:layout_constraintHorizontal_chainStyle="spread">

                <ImageView
                    android:id="@+id/iv_stat_bookings"
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_provider_stat_bookings"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/laundr_blue" />

                <TextView
                    android:id="@+id/tv_stat_bookings_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_10dp"
                    android:text="@string/provider_workspace_zero"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/iv_stat_bookings"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_2dp"
                    android:text="@string/provider_orders_today"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_11sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_stat_bookings_value"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stat_pending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_12dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                app:layout_constraintTop_toBottomOf="@id/provider_dashboard_range"
                app:layout_constraintStart_toEndOf="@id/stat_bookings"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_stat_pending"
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_provider_stat_pending"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/laundr_blue" />

                <TextView
                    android:id="@+id/tv_stat_pending_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_10dp"
                    android:text="@string/provider_workspace_zero"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/iv_stat_pending"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_2dp"
                    android:text="@string/provider_orders_awaiting_response"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_11sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_stat_pending_value"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stat_earnings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                app:layout_constraintTop_toBottomOf="@id/stat_bookings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/stat_rating">

                <ImageView
                    android:id="@+id/iv_stat_earnings"
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_provider_stat_revenue"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/laundr_blue" />

                <TextView
                    android:id="@+id/tv_stat_earnings_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_10dp"
                    android:text="@string/provider_workspace_currency_zero"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/iv_stat_earnings"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_stat_earnings_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_2dp"
                    android:text="@string/provider_workspace_collected_30_days"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_11sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_stat_earnings_value"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stat_rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/layout_12dp"
                android:layout_marginTop="@dimen/layout_12dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                app:layout_constraintTop_toBottomOf="@id/stat_pending"
                app:layout_constraintStart_toEndOf="@id/stat_earnings"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_stat_rating"
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_provider_stat_rating"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/laundr_blue" />

                <TextView
                    android:id="@+id/tv_stat_rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_10dp"
                    android:text="@string/provider_workspace_not_available"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/iv_stat_rating"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_stat_rating_reviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_2dp"
                    android:text="@string/provider_customer_rating"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_11sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_stat_rating_value"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_provider_reports"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/provider_workspace_open_reports"
                android:textAllCaps="false"
                app:layout_constraintTop_toBottomOf="@id/provider_customer_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/provider_activity_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                app:layout_constraintTop_toBottomOf="@id/stat_rating"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_provider_activity_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/provider_workspace_order_activity"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_provider_activity_total" />

                <TextView
                    android:id="@+id/tv_provider_activity_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/provider_workspace_zero_orders"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_11sp"
                    app:layout_constraintTop_toTopOf="@id/tv_provider_activity_title"
                    app:layout_constraintBottom_toBottomOf="@id/tv_provider_activity_title"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/ll_provider_activity_chart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/layout_150dp"
                    android:layout_marginTop="@dimen/layout_12dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/tv_provider_activity_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/provider_customer_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                app:layout_constraintTop_toBottomOf="@id/provider_activity_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_provider_customers_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/provider_workspace_frequent_customers"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_provider_customers_range" />

                <TextView
                    android:id="@+id/tv_provider_customers_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/provider_workspace_last_30_days"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_10sp"
                    app:layout_constraintTop_toTopOf="@id/tv_provider_customers_title"
                    app:layout_constraintBottom_toBottomOf="@id/tv_provider_customers_title"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/provider_customer_list"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_4dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/tv_provider_customers_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Recent Bookings -->
            <TextView
                android:id="@+id/label_recent_bookings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_24dp"
                android:text="@string/recent_bookings"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/btn_provider_reports"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_view_all" />

            <TextView
                android:id="@+id/tv_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_all"
                android:textColor="@color/laundr_blue"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/label_recent_bookings"
                app:layout_constraintBottom_toBottomOf="@id/label_recent_bookings"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/ll_dashboard_bookings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_14dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/label_recent_bookings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_dashboard_bookings_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_14dp"
                android:gravity="center"
                android:padding="@dimen/layout_20dp"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/label_recent_bookings" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom nav (Dashboard tab active) -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/activity_provider_nav_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/layout_56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
