<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".ui.customer.HomeFragment">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingTop="@dimen/space_16">

            <!-- Top bar: avatar, name + address, bell -->
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="@dimen/layout_48dp"
                android:layout_height="@dimen/layout_48dp"
                android:contentDescription="@string/profile_photo"
                android:background="@drawable/bg_thumbnail_placeholder"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                style="@style/TextAppearance.WashLink.Title"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/user_name_placeholder"
                app:layout_constraintTop_toTopOf="@id/iv_avatar"
                app:layout_constraintStart_toEndOf="@id/iv_avatar"
                app:layout_constraintEnd_toStartOf="@id/iv_chat_inbox" />

            <TextView
                android:id="@+id/tv_user_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_4"
                style="@style/TextAppearance.WashLink.Caption"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/user_address_placeholder"
                app:layout_constraintTop_toBottomOf="@id/tv_user_name"
                app:layout_constraintStart_toEndOf="@id/iv_avatar"
                app:layout_constraintEnd_toStartOf="@id/iv_chat_inbox" />

            <FrameLayout
                android:id="@+id/iv_chat_inbox"
                android:layout_width="@dimen/layout_48dp"
                android:layout_height="@dimen/layout_48dp"
                android:layout_marginEnd="@dimen/space_4"
                android:background="@drawable/bg_offer_card"
                android:clickable="true"
                android:contentDescription="@string/provider_chat"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/layout_8dp"
                app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
                app:layout_constraintEnd_toStartOf="@id/iv_calendar"
                app:layout_constraintTop_toTopOf="@id/iv_avatar">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat_bubble"
                    app:tint="@color/color_primary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/iv_calendar"
                android:layout_width="@dimen/layout_48dp"
                android:layout_height="@dimen/layout_48dp"
                android:layout_marginEnd="@dimen/space_4"
                android:background="@drawable/bg_offer_card"
                android:clickable="true"
                android:contentDescription="@string/home_calendar_content_description"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/layout_8dp"
                app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
                app:layout_constraintEnd_toStartOf="@id/iv_bell"
                app:layout_constraintTop_toTopOf="@id/iv_avatar">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/color_primary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/iv_bell"
                android:layout_width="@dimen/layout_48dp"
                android:layout_height="@dimen/layout_48dp"
                android:background="@drawable/bg_offer_card"
                android:clickable="true"
                android:contentDescription="@string/notifications"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/layout_8dp"
                app:layout_constraintTop_toTopOf="@id/iv_avatar"
                app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="@dimen/layout_7dp"
                    android:layout_height="@dimen/layout_7dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/dot_notification" />
            </FrameLayout>

            <!-- Promo banner -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/promo_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_promo_banner"
                android:padding="@dimen/space_16"
                app:layout_constraintTop_toBottomOf="@id/iv_avatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_promo_title"
                    style="@style/TextAppearance.WashLink.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/promo_banner_title"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iv_promo_laundry" />

                <TextView
                    android:id="@+id/tv_promo_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/promo_banner_subtitle"
                    android:textColor="@color/white"
                    style="@style/TextAppearance.WashLink.Body"
                    app:layout_constraintTop_toBottomOf="@id/tv_promo_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iv_promo_laundry" />

                <ImageView
                    android:id="@+id/iv_promo_laundry"
                    android:layout_width="@dimen/layout_108dp"
                    android:layout_height="@dimen/layout_150dp"
                    android:layout_marginStart="@dimen/layout_8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/man_carrying_clothes"
                    android:contentDescription="@string/laundry_delivery_image"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_book_service"
                    style="@style/Widget.WashLink.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_48dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:backgroundTint="@color/white"
                    android:text="@string/book_a_service"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textAppearance="@style/TextAppearance.WashLink.Button"
                    app:cornerRadius="@dimen/radius_button"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_promo_subtitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Active Order section header -->
            <TextView
                android:id="@+id/tv_active_order_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.WashLink.Title"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/active_order"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/promo_banner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_view_details" />

            <TextView
                android:id="@+id/tv_view_details"
                style="@style/TextAppearance.WashLink.Body"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/layout_48dp"
                android:gravity="center_vertical"
                android:text="@string/view_details"
                android:textColor="@color/color_primary"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/tv_active_order_label"
                app:layout_constraintBottom_toBottomOf="@id/tv_active_order_label"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Active order card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/active_order_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/space_16"
                app:layout_constraintTop_toBottomOf="@id/tv_active_order_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:id="@+id/iv_order_icon"
                    android:layout_width="@dimen/layout_36dp"
                    android:layout_height="@dimen/layout_36dp"
                    android:background="@drawable/bg_offer_card"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_order_title"
                    style="@style/TextAppearance.WashLink.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:text="@string/order_wash_fold"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/iv_order_icon"
                    app:layout_constraintStart_toEndOf="@id/iv_order_icon"
                    app:layout_constraintEnd_toStartOf="@id/tv_order_status" />

                <TextView
                    android:id="@+id/tv_order_id"
                    style="@style/TextAppearance.WashLink.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/order_id_placeholder"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintTop_toBottomOf="@id/tv_order_title"
                    app:layout_constraintStart_toEndOf="@id/iv_order_icon" />

                <TextView
                    android:id="@+id/tv_order_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="@dimen/layout_10dp"
                    android:paddingEnd="@dimen/layout_10dp"
                    android:paddingTop="@dimen/layout_4dp"
                    android:paddingBottom="@dimen/layout_4dp"
                    android:text="@string/status_in_progress"
                    android:textColor="@color/status_in_progress_text"
                    android:textSize="@dimen/layout_12sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/iv_order_icon"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Progress track: Pickup -> Cleaning -> Delivery -->
                <View
                    android:id="@+id/progress_track_bg"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/layout_3dp"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@color/progress_track_empty"
                    app:layout_constraintTop_toBottomOf="@id/iv_order_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/progress_track_fill"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/layout_3dp"
                    android:background="@color/progress_track_filled"
                    app:layout_constraintTop_toTopOf="@id/progress_track_bg"
                    app:layout_constraintBottom_toBottomOf="@id/progress_track_bg"
                    app:layout_constraintStart_toStartOf="@id/progress_track_bg"
                    app:layout_constraintEnd_toStartOf="@id/dot_delivery"
                    app:layout_constraintWidth_percent="0.55" />

                <View
                    android:id="@+id/dot_pickup"
                    android:layout_width="@dimen/layout_10dp"
                    android:layout_height="@dimen/layout_10dp"
                    android:background="@drawable/dot_active_indicator"
                    app:layout_constraintTop_toTopOf="@id/progress_track_bg"
                    app:layout_constraintBottom_toBottomOf="@id/progress_track_bg"
                    app:layout_constraintStart_toStartOf="@id/progress_track_bg" />

                <View
                    android:id="@+id/dot_cleaning"
                    android:layout_width="@dimen/layout_10dp"
                    android:layout_height="@dimen/layout_10dp"
                    android:background="@drawable/dot_active_indicator"
                    app:layout_constraintTop_toTopOf="@id/progress_track_bg"
                    app:layout_constraintBottom_toBottomOf="@id/progress_track_bg"
                    app:layout_constraintStart_toStartOf="@id/progress_track_bg"
                    app:layout_constraintEnd_toEndOf="@id/progress_track_bg" />

                <View
                    android:id="@+id/dot_delivery"
                    android:layout_width="@dimen/layout_10dp"
                    android:layout_height="@dimen/layout_10dp"
                    android:background="@drawable/dot_inactive_indicator"
                    app:layout_constraintTop_toTopOf="@id/progress_track_bg"
                    app:layout_constraintBottom_toBottomOf="@id/progress_track_bg"
                    app:layout_constraintEnd_toEndOf="@id/progress_track_bg" />

                <TextView
                    android:id="@+id/tv_label_pickup"
                    style="@style/TextAppearance.WashLink.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/label_pickup"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintTop_toBottomOf="@id/dot_pickup"
                    app:layout_constraintStart_toStartOf="@id/dot_pickup" />

                <TextView
                    android:id="@+id/tv_label_cleaning"
                    style="@style/TextAppearance.WashLink.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/label_cleaning"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/dot_cleaning"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_label_delivery"
                    style="@style/TextAppearance.WashLink.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/label_delivery"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintTop_toBottomOf="@id/dot_delivery"
                    app:layout_constraintEnd_toEndOf="@id/dot_delivery" />

                <View
                    android:id="@+id/divider_order"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/layout_1dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@color/divider_gray"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_cleaning"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_eta_label"
                    style="@style/TextAppearance.WashLink.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/estimated_arrival"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintTop_toBottomOf="@id/divider_order"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_eta_value" />

                <TextView
                    android:id="@+id/tv_eta_value"
                    style="@style/TextAppearance.WashLink.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eta_placeholder"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/tv_eta_label"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Welcome offer -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/offer_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_offer_card"
                android:padding="@dimen/space_16"
                app:layout_constraintTop_toBottomOf="@id/active_order_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_offer_label"
                    style="@style/TextAppearance.WashLink.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_offer"
                    android:textColor="@color/color_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_offer_desc"
                    style="@style/TextAppearance.WashLink.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/welcome_offer_desc"
                    android:textColor="@color/text_primary"
                    android:textStyle="normal"
                    app:layout_constraintTop_toBottomOf="@id/tv_offer_label"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- More Options -->
            <TextView
                android:id="@+id/tv_more_options_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.WashLink.Title"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/more_options"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/offer_card"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/row_order_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:minHeight="@dimen/layout_64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/space_8"
                android:paddingBottom="@dimen/space_8"
                app:layout_constraintTop_toBottomOf="@id/tv_more_options_label">

                <ImageView
                    android:layout_width="@dimen/layout_22dp"
                    android:layout_height="@dimen/layout_22dp"
                    android:src="@drawable/ic_nav_history"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_16"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.WashLink.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_history"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.WashLink.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/order_history_desc"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_profile_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/layout_64dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/space_8"
                android:paddingBottom="@dimen/space_8"
                app:layout_constraintTop_toBottomOf="@id/row_order_history">

                <ImageView
                    android:layout_width="@dimen/layout_22dp"
                    android:layout_height="@dimen/layout_22dp"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_16"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.WashLink.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_settings"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.WashLink.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/profile_settings_desc"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/layout_20dp"
                    android:layout_height="@dimen/layout_20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom nav (Home tab active) -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/activity_customer_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
