<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:padding="@dimen/layout_20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_overview_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_24sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_12dp"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_overview"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/layout_48dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_filter_overview"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/divider_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_bookings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/layout_48dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_filter_bookings"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/divider_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_providers"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/layout_48dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_filter_providers"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/divider_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_users"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/layout_48dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_filter_users"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/divider_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_reports"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/layout_48dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_filter_reports"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/divider_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_refresh"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/layout_48dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_filter_refresh"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/divider_gray" />
    </LinearLayout>
    </HorizontalScrollView>

    <!-- The web workspace uses panels and a status area; keep the same hierarchy on mobile. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_4dp"
        android:text="@string/admin_overview_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_13sp" />

    <LinearLayout
        android:id="@+id/admin_report_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_12dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/admin_report_period_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="@dimen/layout_4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_report_period"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_13sp" />

            <Spinner
                android:id="@+id/admin_report_period"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_48dp"
                android:contentDescription="@string/admin_report_period" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/admin_report_status_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/layout_4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_report_status"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_13sp" />

            <Spinner
                android:id="@+id/admin_report_status"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_48dp"
                android:contentDescription="@string/admin_report_status" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_admin_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layout_12dp"
        android:gravity="center"
        android:minHeight="@dimen/layout_96dp"
        android:padding="@dimen/layout_24dp"
        android:text="@string/admin_loading"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll_admin_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:contentDescription="@string/admin_items_description">

        <LinearLayout
            android:id="@+id/admin_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_admin_logout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/layout_48dp"
        android:layout_gravity="end"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/admin_sign_out"
        android:textAllCaps="false" />

</LinearLayout>
