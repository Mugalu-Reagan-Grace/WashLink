<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".PaymentActivity">

    <!-- Header -->
    <ImageView
        android:id="@+id/btn_back"
        style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_12dp"
        android:layout_marginEnd="@dimen/layout_12dp"
        android:text="@string/payment_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_17sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/iv_bell" />

    <FrameLayout
        android:id="@+id/iv_bell"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bell"
            app:tint="@color/laundr_blue"
            android:contentDescription="@null" />

        <View
            android:layout_width="@dimen/layout_7dp"
            android:layout_height="@dimen/layout_7dp"
            android:layout_gravity="top|end"
            android:background="@drawable/dot_notification" />
    </FrameLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/layout_20dp"
            android:paddingEnd="@dimen/layout_20dp"
            android:paddingTop="@dimen/layout_20dp">

            <!-- Secure Payment badge -->
            <LinearLayout
                android:id="@+id/row_secure_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_offer_card"
                android:padding="@dimen/layout_12dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/layout_18dp"
                    android:layout_height="@dimen/layout_18dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/layout_10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/secure_payment"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/layout_13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/layout_1dp"
                        android:text="@string/secure_payment_note"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/layout_11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Visa and Mastercard card payment -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_20dp"
                android:background="@drawable/bg_card_selected_outline"
                android:padding="@dimen/layout_14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@id/row_secure_payment">

                <TextView
                    android:id="@+id/tv_card_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_card_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/radio_card_payment" />

                <TextView
                    android:id="@+id/tv_card_checkout_note"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_2dp"
                    android:text="@string/payment_card_checkout_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_11sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_card_label"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/radio_card_payment" />

                <ImageView
                    android:id="@+id/icon_visa"
                    android:layout_width="@dimen/layout_48dp"
                    android:layout_height="@dimen/layout_32dp"
                    android:layout_marginTop="@dimen/layout_6dp"
                    android:contentDescription="@string/payment_visa"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_visa_card"
                    app:layout_constraintTop_toBottomOf="@id/tv_card_checkout_note"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/icon_mastercard"
                    android:layout_width="@dimen/layout_48dp"
                    android:layout_height="@dimen/layout_32dp"
                    android:layout_marginStart="@dimen/layout_8dp"
                    android:contentDescription="@string/payment_mastercard"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mastercard"
                    app:layout_constraintTop_toTopOf="@id/icon_visa"
                    app:layout_constraintStart_toEndOf="@id/icon_visa" />

                <RadioButton
                    android:id="@+id/radio_card_payment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/layout_48dp"
                    android:minHeight="@dimen/layout_48dp"
                    android:checked="true"
                    android:buttonTint="@color/laundr_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Airtel Money -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_airtel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@id/card_payment">

                <ImageView
                    android:id="@+id/icon_airtel"
                    android:layout_width="@dimen/layout_36dp"
                    android:layout_height="@dimen/layout_24dp"
                    android:contentDescription="@string/payment_airtel_money"
                    android:src="@drawable/ic_airtel_logo"
                    android:scaleType="centerInside"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_airtel_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_12dp"
                    android:text="@string/payment_airtel_money"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/icon_airtel"
                    app:layout_constraintStart_toEndOf="@id/icon_airtel"
                    app:layout_constraintEnd_toStartOf="@id/radio_airtel" />

                <TextView
                    android:id="@+id/tv_airtel_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_12dp"
                    android:layout_marginTop="@dimen/layout_2dp"
                    android:text="@string/payment_airtel_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_airtel_label"
                    app:layout_constraintStart_toEndOf="@id/icon_airtel"
                    app:layout_constraintEnd_toStartOf="@id/radio_airtel" />

                <RadioButton
                    android:id="@+id/radio_airtel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/layout_48dp"
                    android:minHeight="@dimen/layout_48dp"
                    android:checked="false"
                    android:buttonTint="@color/laundr_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- MTN Mobile Money -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_mtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@id/card_airtel">

                <ImageView
                    android:id="@+id/icon_mtn"
                    android:layout_width="@dimen/layout_36dp"
                    android:layout_height="@dimen/layout_24dp"
                    android:contentDescription="@string/payment_mtn_mobile_money"
                    android:src="@drawable/ic_mtn_momo"
                    android:scaleType="centerInside"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_mtn_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_12dp"
                    android:text="@string/payment_mtn_mobile_money"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/icon_mtn"
                    app:layout_constraintStart_toEndOf="@id/icon_mtn"
                    app:layout_constraintEnd_toStartOf="@id/radio_mtn" />

                <TextView
                    android:id="@+id/tv_mtn_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_12dp"
                    android:layout_marginTop="@dimen/layout_2dp"
                    android:text="@string/payment_mtn_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_mtn_label"
                    app:layout_constraintStart_toEndOf="@id/icon_mtn"
                    app:layout_constraintEnd_toStartOf="@id/radio_mtn" />

                <RadioButton
                    android:id="@+id/radio_mtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/layout_48dp"
                    android:minHeight="@dimen/layout_48dp"
                    android:checked="false"
                    android:buttonTint="@color/laundr_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Cash on Delivery -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_cash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@id/card_mtn">

                <ImageView
                    android:id="@+id/icon_cash"
                    android:layout_width="@dimen/layout_36dp"
                    android:layout_height="@dimen/layout_24dp"
                    android:contentDescription="@string/payment_cash_on_delivery"
                    android:src="@drawable/ic_cash"
                    android:scaleType="centerInside"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_cash_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_12dp"
                    android:text="@string/payment_cash_on_delivery"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/icon_cash"
                    app:layout_constraintStart_toEndOf="@id/icon_cash"
                    app:layout_constraintEnd_toStartOf="@id/radio_cash" />

                <TextView
                    android:id="@+id/tv_cash_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/layout_12dp"
                    android:layout_marginTop="@dimen/layout_2dp"
                    android:text="@string/payment_cash_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_cash_label"
                    app:layout_constraintStart_toEndOf="@id/icon_cash"
                    app:layout_constraintEnd_toStartOf="@id/radio_cash" />

                <RadioButton
                    android:id="@+id/radio_cash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/layout_48dp"
                    android:minHeight="@dimen/layout_48dp"
                    android:checked="false"
                    android:buttonTint="@color/laundr_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Order Total -->
            <TextView
                android:id="@+id/label_order_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_24dp"
                android:text="@string/order_total"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/card_cash" />

            <LinearLayout
                android:id="@+id/row_subtotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/label_order_total">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/subtotal"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_13sp" />

                <TextView
                    android:id="@+id/tv_payment_subtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_subtotal_amount"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_tax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/row_subtotal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/service_fee"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_13sp" />

                <TextView
                    android:id="@+id/tv_payment_tax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_tax_amount"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/row_tax">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_payment_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_total_amount"
                    android:textColor="@color/laundr_blue"
                    android:textSize="@dimen/layout_16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_authorize_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:text="@string/authorize_payment_note"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_11sp"
                android:lineSpacingExtra="@dimen/layout_1dp"
                app:layout_constraintTop_toBottomOf="@id/row_total" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky bottom bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="@dimen/layout_8dp"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:paddingTop="@dimen/layout_12dp"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_52dp"
            android:text="@string/pay_amount"
            android:textAllCaps="false"
            android:textSize="@dimen/layout_15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/laundr_blue"
            app:cornerRadius="@dimen/radius_button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
