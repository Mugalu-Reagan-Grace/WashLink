<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/layout_16dp"
        android:paddingTop="@dimen/layout_10dp"
        android:paddingEnd="@dimen/layout_16dp">

        <ImageView
            android:id="@+id/btn_provider_menu"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:contentDescription="@string/provider_nav_more"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/layout_6dp"
            android:src="@drawable/ic_menu_lines" />

        <ImageView
            android:id="@+id/btn_provider_staff_back"
            style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
            android:layout_marginStart="@dimen/layout_4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/layout_8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/provider_workspace_staff_roster"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_provider_staff_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/provider_workspace_loading_roster"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_provider_staff_add"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/provider_workspace_add" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingTop="@dimen/layout_8dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:text="@string/provider_workspace_roster_note"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/layout_13sp" />

    <TextView
        android:id="@+id/tv_provider_staff_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/layout_20dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp">

        <LinearLayout
            android:id="@+id/provider_staff_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_56dp"
        layout="@layout/activity_provider_nav_bar" />
</LinearLayout>
