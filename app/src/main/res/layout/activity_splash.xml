<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/laundr_blue">

    <LinearLayout
        android:id="@+id/logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_logo_drop"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_main_washlink"
            app:tint="@color/white" />
        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/splash_tagline"
            android:textColor="@color/splash_tagline_text"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColorLink="@color/splash_tagline_text"
            android:layout_gravity="center"
            app:layout_constraintTop_toBottomOf="@id/logo_container"
            app:layout_constraintStart_toStartOf="@id/logo_container"
            app:layout_constraintEnd_toEndOf="@id/logo_container" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
