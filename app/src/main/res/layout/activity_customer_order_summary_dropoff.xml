<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".OrderSummaryDropOffActivity">

    <!-- Header -->
    <ImageView
        android:id="@+id/btn_back"
        style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_12dp"
        android:layout_marginEnd="@dimen/layout_12dp"
        android:text="@string/order_summary_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_17sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/iv_bell" />

    <FrameLayout
        android:id="@+id/iv_bell"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginEnd="@dimen/layout_20dp"
        android:padding="@dimen/layout_12dp"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bell"
            app:tint="@color/laundr_blue"
            android:contentDescription="@null" />

        <View
            android:layout_width="@dimen/layout_7dp"
            android:layout_height="@dimen/layout_7dp"
            android:layout_gravity="top|end"
            android:background="@drawable/dot_notification" />
    </FrameLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/layout_20dp"
            android:paddingEnd="@dimen/layout_20dp"
            android:paddingTop="@dimen/layout_20dp">

            <!-- Service Type row -->
            <TextView
                android:id="@+id/label_service_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/service_type"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_13sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_change_service" />

            <TextView
                android:id="@+id/tv_change_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/layout_48dp"
                android:gravity="center_vertical"
                android:text="@string/change"
                android:textColor="@color/laundr_blue"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/change_service_action"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintTop_toTopOf="@id/label_service_type"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_service_type_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_4dp"
                android:text="@string/service_type_dropoff"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/label_service_type"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Drop-off Logistics card (no home address - customer drops off in person) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_logistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_service_type_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_logistics_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dropoff_logistics"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_edit_logistics" />

                <TextView
                    android:id="@+id/tv_edit_logistics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/layout_48dp"
                    android:gravity="center_vertical"
                    android:text="@string/edit"
                    android:textColor="@color/laundr_blue"
                    android:textSize="@dimen/layout_12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/edit_logistics_action"
                    android:background="?attr/selectableItemBackground"
                    app:layout_constraintTop_toTopOf="@id/tv_logistics_label"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_datetime_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_8dp"
                    android:text="@string/pickup_datetime_value"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_logistics_label"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/divider1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/layout_1dp"
                    android:layout_marginTop="@dimen/layout_12dp"
                    android:background="@color/divider_gray"
                    app:layout_constraintTop_toBottomOf="@id/tv_datetime_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/label_items_inline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_10dp"
                    android:text="@string/number_of_items"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/divider1"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_items_value_inline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_item_count"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_12sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/label_items_inline"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/label_weight_inline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_6dp"
                    android:text="@string/estimated_weight"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/label_items_inline"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_weight_value_inline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weight_range"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_12sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/label_weight_inline"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_fee_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_16dp"
                android:background="@drawable/bg_offer_card"
                android:padding="@dimen/layout_10dp"
                android:text="@string/dropoff_fee_note"
                android:textColor="@color/laundr_blue"
                android:textSize="@dimen/layout_12sp"
                app:layout_constraintTop_toBottomOf="@id/card_logistics"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Price Summary -->
            <TextView
                android:id="@+id/label_price_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_20dp"
                android:text="@string/price_summary"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_fee_note"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/row_base_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/label_price_summary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/base_service_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_13sp" />

                <TextView
                    android:id="@+id/tv_base_service_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summary_subtotal_amount"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_13sp" />
            </LinearLayout>

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_1dp"
                android:layout_marginTop="@dimen/layout_12dp"
                android:background="@color/divider_gray"
                app:layout_constraintTop_toBottomOf="@id/row_base_service" />

            <LinearLayout
                android:id="@+id/row_subtotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_10dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/divider2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/subtotal"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_13sp" />

                <TextView
                    android:id="@+id/tv_subtotal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summary_subtotal_amount"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_tax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/row_subtotal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/service_fee"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_13sp" />

                <TextView
                    android:id="@+id/tv_tax_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summary_pickup_fee_amount"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/row_tax">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropoff_summary_total_amount"
                    android:textColor="@color/laundr_blue"
                    android:textSize="@dimen/layout_16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky bottom bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="@dimen/layout_8dp"
        android:paddingStart="@dimen/layout_20dp"
        android:paddingEnd="@dimen/layout_20dp"
        android:paddingTop="@dimen/layout_12dp"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_proceed_payment"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_52dp"
            android:text="@string/proceed_to_payment"
            android:textAllCaps="false"
            android:textSize="@dimen/layout_15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/laundr_blue"
            app:cornerRadius="@dimen/radius_button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
