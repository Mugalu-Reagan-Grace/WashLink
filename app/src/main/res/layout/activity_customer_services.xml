<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".ui.customer.ServicesFragment">

    <!-- Header -->
    <ImageView
        android:id="@+id/btn_back"
        style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_12dp"
        android:layout_marginEnd="@dimen/layout_12dp"
        android:text="@string/select_service"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_17sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/iv_bell" />

    <FrameLayout
        android:id="@+id/iv_bell"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginEnd="@dimen/space_16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/notifications"
        android:focusable="true"
        android:padding="@dimen/space_8"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bell"
            app:tint="@color/laundr_blue"
            android:contentDescription="@null" />

        <View
            android:layout_width="@dimen/layout_7dp"
            android:layout_height="@dimen/layout_7dp"
            android:layout_gravity="top|end"
            android:background="@drawable/dot_notification" />
    </FrameLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_16"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingTop="@dimen/space_24">

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.WashLink.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_service_title"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/TextAppearance.WashLink.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_8dp"
                android:text="@string/select_service_subtitle"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="@dimen/layout_2dp"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Drop Off card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_drop_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_card_bordered"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="@dimen/space_16"
                android:minHeight="@dimen/layout_120dp"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:id="@+id/thumb_drop_off"
                    android:layout_width="@dimen/layout_72dp"
                    android:layout_height="@dimen/layout_72dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_thumbnail_placeholder" />

                    <TextView
                        android:id="@+id/tv_save_money"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_save_badge"
                        android:paddingStart="@dimen/layout_6dp"
                        android:paddingEnd="@dimen/layout_6dp"
                        android:paddingTop="@dimen/space_4"
                        android:paddingBottom="@dimen/layout_2dp"
                        android:text="@string/save_money"
                        android:textColor="@color/white"
                        android:textSize="@dimen/layout_11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_drop_off_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    style="@style/TextAppearance.WashLink.Title"
                    android:text="@string/drop_off"
                    android:textColor="@color/text_primary"
                    app:layout_constraintTop_toTopOf="@id/thumb_drop_off"
                    app:layout_constraintStart_toEndOf="@id/thumb_drop_off"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_drop_off_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/drop_off_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    android:lineSpacingExtra="@dimen/layout_1dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_drop_off_title"
                    app:layout_constraintStart_toEndOf="@id/thumb_drop_off"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_drop_off_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/price_per_kg"
                    android:textColor="@color/laundr_blue"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_drop_off_desc"
                    app:layout_constraintStart_toEndOf="@id/thumb_drop_off"
                    app:layout_constraintBottom_toBottomOf="@id/thumb_drop_off" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Pickup & Delivery card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_pickup_delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_card_bordered"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="@dimen/space_16"
                android:minHeight="@dimen/layout_120dp"
                app:layout_constraintTop_toBottomOf="@id/card_drop_off"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:id="@+id/thumb_pickup"
                    android:layout_width="@dimen/layout_72dp"
                    android:layout_height="@dimen/layout_72dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_thumbnail_placeholder" />

                    <TextView
                        android:id="@+id/tv_save_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_save_badge"
                        android:paddingStart="@dimen/layout_6dp"
                        android:paddingEnd="@dimen/layout_6dp"
                        android:paddingTop="@dimen/space_4"
                        android:paddingBottom="@dimen/layout_2dp"
                        android:text="@string/save_time"
                        android:textColor="@color/white"
                        android:textSize="@dimen/layout_11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_pickup_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    style="@style/TextAppearance.WashLink.Title"
                    android:text="@string/pickup_delivery"
                    android:textColor="@color/text_primary"
                    app:layout_constraintTop_toTopOf="@id/thumb_pickup"
                    app:layout_constraintStart_toEndOf="@id/thumb_pickup"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_pickup_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/pickup_delivery_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    android:lineSpacingExtra="@dimen/layout_1dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_pickup_title"
                    app:layout_constraintStart_toEndOf="@id/thumb_pickup"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_pickup_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/price_per_kg"
                    android:textColor="@color/laundr_blue"
                    android:textSize="@dimen/layout_14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_pickup_desc"
                    app:layout_constraintStart_toEndOf="@id/thumb_pickup"
                    app:layout_constraintBottom_toBottomOf="@id/thumb_pickup" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom nav (Services tab active) -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/activity_customer_nav_bar_services"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
