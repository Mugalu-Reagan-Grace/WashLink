<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:background="@color/white"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/iv_nav_dashboard"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_nav_home"
        android:contentDescription="@string/nav_home"
        app:tint="@color/nav_inactive" />

    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

    <ImageView
        android:id="@+id/iv_nav_bookings"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_nav_history"
        android:contentDescription="@string/nav_history"
        app:tint="@color/nav_inactive" />

    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

    <ImageView
        android:id="@+id/iv_nav_services"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_nav_services"
        android:contentDescription="@string/nav_services"
        app:tint="@color/nav_inactive" />

    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

    <ImageView
        android:id="@+id/iv_nav_chat"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:padding="7dp"
        android:src="@drawable/ic_chat_bubble"
        android:contentDescription="@string/provider_chat"
        app:tint="@color/nav_inactive" />

    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

    <ImageView
        android:id="@+id/iv_nav_profile"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_nav_profile"
        android:contentDescription="@string/nav_profile"
        app:tint="@color/nav_inactive" />
</LinearLayout>
