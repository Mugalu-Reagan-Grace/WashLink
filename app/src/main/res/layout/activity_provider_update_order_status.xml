<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".UpdateOrderStatusActivity">

    <!-- Header -->
    <ImageView
        android:id="@+id/btn_back"
        style="@style/WashLinkBackButton"
        android:contentDescription="@string/back"
        android:layout_width="@dimen/layout_48dp"
        android:layout_height="@dimen/layout_48dp"
        android:layout_marginStart="@dimen/layout_20dp"
        android:layout_marginTop="@dimen/layout_20dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_12dp"
        android:text="@string/update_order_status_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/layout_17sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/layout_16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/layout_20dp"
            android:paddingEnd="@dimen/layout_20dp"
            android:paddingTop="@dimen/layout_20dp">

            <!-- Order summary card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_order_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_bordered"
                android:padding="@dimen/layout_14dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_order_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/provider_workspace_order_id_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/layout_15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_customer_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/layout_4dp"
                    android:text="@string/provider_workspace_loading_order_details"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/layout_12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_order_id"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_provider_approval_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_10dp"
                android:background="@drawable/bg_status_pill"
                android:padding="@dimen/layout_12dp"
                android:text="@string/provider_approval_checking"
                android:textColor="@color/pending_text"
                android:textSize="@dimen/layout_13sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/card_order_info" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_call_customer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/layout_8dp"
                android:text="@string/provider_workspace_call_customer"
                android:textAllCaps="false"
                app:layout_constraintTop_toBottomOf="@id/tv_provider_approval_notice" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_assign_rider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/layout_12dp"
                android:text="@string/provider_workspace_assign_rider"
                android:textAllCaps="false"
                app:layout_constraintTop_toBottomOf="@id/btn_call_customer" />

            <!-- Current status -->
            <TextView
                android:id="@+id/label_current_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_20dp"
                android:text="@string/current_status"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/layout_12sp"
                app:layout_constraintTop_toBottomOf="@id/btn_assign_rider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_current_status_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_6dp"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="@dimen/layout_12dp"
                android:paddingEnd="@dimen/layout_12dp"
                android:paddingTop="@dimen/layout_6dp"
                android:paddingBottom="@dimen/layout_6dp"
                android:text="@string/status_picked_up"
                android:textColor="@color/status_in_progress_text"
                android:textSize="@dimen/layout_13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/label_current_status"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Mark As -->
            <TextView
                android:id="@+id/label_mark_as"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_24dp"
                android:text="@string/mark_as"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/layout_14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_current_status_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Status options: radio-style selectable rows -->
            <LinearLayout
                android:id="@+id/status_options"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_12dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/label_mark_as"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RadioGroup
                    android:id="@+id/radio_group_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/opt_washing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:layout_marginBottom="@dimen/layout_4dp"
                        android:text="@string/status_washing"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/layout_14sp"
                        android:padding="@dimen/layout_10dp"
                        android:buttonTint="@color/laundr_blue"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/opt_drying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:layout_marginBottom="@dimen/layout_4dp"
                        android:text="@string/status_drying"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/layout_14sp"
                        android:padding="@dimen/layout_10dp"
                        android:buttonTint="@color/laundr_blue" />

                    <RadioButton
                        android:id="@+id/opt_ready"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:layout_marginBottom="@dimen/layout_4dp"
                        android:text="@string/status_ready"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/layout_14sp"
                        android:padding="@dimen/layout_10dp"
                        android:buttonTint="@color/laundr_blue" />

                    <RadioButton
                        android:id="@+id/opt_out_for_delivery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:layout_marginBottom="@dimen/layout_4dp"
                        android:text="@string/status_out_for_delivery"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/layout_14sp"
                        android:padding="@dimen/layout_10dp"
                        android:buttonTint="@color/laundr_blue" />

                    <RadioButton
                        android:id="@+id/opt_delivered"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/status_delivered"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/layout_14sp"
                        android:padding="@dimen/layout_10dp"
                        android:buttonTint="@color/laundr_blue" />

                </RadioGroup>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_status"
                android:layout_width="0dp"
                android:layout_height="@dimen/layout_52dp"
                android:layout_marginTop="@dimen/layout_24dp"
                android:text="@string/update_status_button"
                android:textAllCaps="false"
                android:textSize="@dimen/layout_15sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/laundr_blue"
                app:cornerRadius="@dimen/layout_12dp"
                app:layout_constraintTop_toBottomOf="@id/status_options"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
