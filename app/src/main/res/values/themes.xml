<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.WashLink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/laundr_blue</item>
        <item name="colorPrimaryVariant">@color/laundr_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/laundr_blue</item>
        <item name="colorSecondaryVariant">@color/laundr_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textViewStyle">@style/Widget.WashLink.TextView</item>
        <item name="buttonStyle">@style/Widget.WashLink.Button</item>

        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorControlHighlight">@color/laundr_blue</item>
    </style>

    <style name="Theme.WashLink" parent="Base.Theme.WashLink" />

    <style name="Widget.WashLink.TextView" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.WashLink.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="Widget.WashLink.EditText" parent="@android:style/Widget.EditText">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="Widget.WashLink.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <!-- Backward-compatible alias if older code references the lowercase version -->
    <style name="Theme.Washlink" parent="Theme.WashLink" />

</resources>
