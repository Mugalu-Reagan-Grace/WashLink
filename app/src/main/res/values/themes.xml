<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.WashLink" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryVariant">@color/color_secondary_variant</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>

        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textViewStyle">@style/Widget.WashLink.TextView</item>
        <item name="buttonStyle">@style/Widget.WashLink.Button</item>

        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorControlHighlight">@color/color_primary</item>
    </style>

    <style name="Theme.WashLink" parent="Base.Theme.WashLink" />

    <style name="Theme.WashLink.Cream" parent="Theme.WashLink">
        <item name="android:colorBackground">@color/cream_surface</item>
        <item name="colorSurface">@color/cream_surface</item>
        <item name="colorOnSurface">@color/cream_text_primary</item>
        <item name="android:textColorPrimary">@color/cream_text_primary</item>
        <item name="android:textColorSecondary">@color/cream_text_secondary</item>
        <item name="android:statusBarColor">@color/cream_raised</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorControlHighlight">@color/color_ripple_cream</item>
    </style>

    <style name="TextAppearance.WashLink.Headline" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.WashLink.Title" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.WashLink.Body" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.WashLink.Caption" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.WashLink.Button" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.WashLink.TextView" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.WashLink.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="WashLinkBackButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:src">@drawable/ic_back_arrow</item>
        <item name="android:tint">@color/laundr_blue</item>
        <item name="android:background">@drawable/bg_back_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:contentDescription">@string/back</item>
    </style>

    <style name="Widget.WashLink.EditText" parent="@android:style/Widget.EditText">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="WashLinkInputText">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/hint_gray</item>
    </style>

    <style name="Widget.WashLink.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.WashLink.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="Widget.WashLink.Chip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <style name="Widget.WashLink.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <!-- Backward-compatible alias if older code references the lowercase version -->
    <style name="Theme.Washlink" parent="Theme.WashLink" />

    <style name="Theme.WashLink_CalendarBlue" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="android:colorAccent">@color/color_primary</item>
    </style>

    <style name="Theme.WashLink_CalendarAmber" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_calendar_amber</item>
        <item name="colorSecondary">@color/color_calendar_amber</item>
        <item name="android:colorAccent">@color/color_calendar_amber</item>
    </style>

    <style name="Theme.WashLink_CalendarEmerald" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_calendar_emerald</item>
        <item name="colorSecondary">@color/color_calendar_emerald</item>
        <item name="android:colorAccent">@color/color_calendar_emerald</item>
    </style>

    <style name="Theme.WashLink_CalendarViolet" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_calendar_violet</item>
        <item name="colorSecondary">@color/color_calendar_violet</item>
        <item name="android:colorAccent">@color/color_calendar_violet</item>
    </style>

</resources>
