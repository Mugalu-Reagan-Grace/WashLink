rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isSuspended', false) != true;
    }

    function isProvider() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'provider'
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isSuspended', false) != true;
    }

    function isActiveUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isSuspended', false) != true;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['customer', 'provider']
        && request.resource.data.get('isSuspended', false) == false;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && ((request.auth.uid == uid
            && isActiveUser()
            && request.resource.data.get('isSuspended', false)
              == resource.data.get('isSuspended', false))
          || (isAdmin()
            && request.auth.uid != uid
            && resource.data.role != 'admin'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isSuspended'])));
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read, delete: if isActiveUser() && request.auth.uid == uid;
      }

      match /payoutProfile/{profileId} {
        allow read: if isActiveUser() && request.auth.uid == uid;
      }

      match /payoutAttempts/{bookingId} {
        allow read: if isActiveUser() && request.auth.uid == uid;
      }
    }

    match /providers/{uid} {
      allow read: if isActiveUser() || isAdmin();
      allow create: if isAdmin()
        || (isProvider() && request.auth.uid == uid
          && request.resource.data.get('isApproved', false) == false);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isApproved']))
        || (isProvider() && request.auth.uid == uid
          && request.resource.data.get('isApproved', false)
            == resource.data.get('isApproved', false));
      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if isActiveUser() || isAdmin();
      }

      match /riders/{riderId} {
        allow read: if isAdmin()
          || (isProvider() && request.auth.uid == uid);
        allow create: if isProvider()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'phone', 'isActive', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 7
          && request.resource.data.phone.size() <= 30
          && request.resource.data.isActive == true;

        allow update: if isProvider()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'isActive'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 7
          && request.resource.data.phone.size() <= 30
          && request.resource.data.isActive is bool;
        allow delete: if false;
      }
    }

    match /bookings/{bookingId} {
      allow read: if isActiveUser()
        && (resource.data.customerId == request.auth.uid
          || resource.data.providerId == request.auth.uid
          || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
