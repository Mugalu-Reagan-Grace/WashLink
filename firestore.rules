rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isSuspended', false) != true;
    }

    function isProvider() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'provider'
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isSuspended', false) != true;
    }

    function isActiveUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isSuspended', false) != true;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['customer', 'provider']
        && request.resource.data.get('isSuspended', false) == false;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && ((request.auth.uid == uid
            && isActiveUser()
            && request.resource.data.get('isSuspended', false)
              == resource.data.get('isSuspended', false))
          || (isAdmin()
            && request.auth.uid != uid
            && resource.data.role != 'admin'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isSuspended'])));
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read, delete: if isActiveUser() && request.auth.uid == uid;
        allow update: if isActiveUser()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }

      match /payoutProfile/{profileId} {
        allow read: if isActiveUser() && request.auth.uid == uid;
      }

      match /payoutAttempts/{bookingId} {
        allow read: if isActiveUser() && request.auth.uid == uid;
      }
    }

    match /providers/{uid} {
      allow read: if isActiveUser() || isAdmin();
      allow create: if isAdmin()
        || (isProvider() && request.auth.uid == uid
          && request.resource.data.get('isApproved', false) == false);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isApproved']))
        || (isProvider() && request.auth.uid == uid
          && request.resource.data.get('isApproved', false)
            == resource.data.get('isApproved', false));
      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if isActiveUser() || isAdmin();
      }

      match /riders/{riderId} {
        allow read: if isAdmin()
          || (isProvider() && request.auth.uid == uid);
        allow create: if isProvider()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'phone', 'isActive', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 7
          && request.resource.data.phone.size() <= 30
          && request.resource.data.isActive == true;

        allow update: if isProvider()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'isActive'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 7
          && request.resource.data.phone.size() <= 30
          && request.resource.data.isActive is bool;
        allow delete: if false;
      }
    }

    match /bookings/{bookingId} {
      allow read: if isActiveUser()
        && (resource.data.customerId == request.auth.uid
          || resource.data.providerId == request.auth.uid
          || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    function isChatParticipant(chat) {
      return isActiveUser()
        && chat.participantIds is list
        && request.auth.uid in chat.participantIds;
    }

    function mayCreateChat(chat, chatId) {
      return chat.customerId is string
        && chat.providerId is string
        && chat.customerId != chat.providerId
        && (chatId == chat.customerId + '_' + chat.providerId
          || chatId == chat.providerId + '_' + chat.customerId)
        && chat.participantIds == [chat.customerId, chat.providerId]
        && chat.customerName is string
        && chat.customerName
          == get(/databases/$(database)/documents/users/$(chat.customerId)).data.name
        && chat.providerName is string
        && chat.providerName
          == get(/databases/$(database)/documents/providers/$(chat.providerId))
            .data.businessName
        && ((request.auth.uid == chat.customerId
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                == 'customer'
              && isActiveUser()
              && exists(/databases/$(database)/documents/users/$(chat.customerId))
              && get(/databases/$(database)/documents/users/$(chat.customerId))
                .data.get('isSuspended', false) != true
              && exists(/databases/$(database)/documents/providers/$(chat.providerId))
              && get(/databases/$(database)/documents/providers/$(chat.providerId))
                .data.get('isApproved', false) == true)
            || (request.auth.uid == chat.providerId
              && isProvider()
              && exists(/databases/$(database)/documents/users/$(chat.customerId))
              && get(/databases/$(database)/documents/users/$(chat.customerId)).data.role
                == 'customer'
              && get(/databases/$(database)/documents/users/$(chat.customerId))
                .data.get('isSuspended', false) != true
              && get(/databases/$(database)/documents/providers/$(request.auth.uid))
                .data.get('isApproved', false) == true));
    }

    match /chats/{chatId} {
      allow get: if signedIn()
        && (resource == null || isChatParticipant(resource.data));
      allow list: if isChatParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'customerId', 'providerId', 'participantIds', 'customerName',
          'providerName', 'lastMessage', 'createdAt', 'lastMessageAt'
        ])
        && mayCreateChat(request.resource.data, chatId)
        && request.resource.data.lastMessage == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time;
      allow update: if isChatParticipant(resource.data)
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId'])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if signedIn()
          && isChatParticipant(
            get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          && request.resource.data.senderRole in ['customer', 'provider']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
